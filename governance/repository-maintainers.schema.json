{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["organization", "requiredPermission", "repositories"],
  "properties": {
    "organization": { "const": "omdsh-dev" },
    "requiredPermission": { "const": "admin" },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  },
  "additionalProperties": false
}
